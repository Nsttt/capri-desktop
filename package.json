{
  "name": "capri-desktop",
  "version": "0.7.0",
  "description": "Capri, the Project Capricorn construct, living on your desktop and narrating what Claude Code is doing.",
  "author": "mochiiwuff",
  "repository": "github:mochiiwuff/capri-desktop",
  "main": "out/src/main/main.js",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.web.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "demo": "npm run build && node out/scripts/demo.js",
    "hooks:install": "npm run build && node out/scripts/install-hooks.js",
    "hooks:uninstall": "npm run build && node out/scripts/install-hooks.js --uninstall",
    "hooks:codex:install": "npm run build && node out/scripts/install-codex-hooks.js",
    "hooks:codex:uninstall": "npm run build && node out/scripts/install-codex-hooks.js --uninstall",
    "hooks:agy:install": "npm run build && node out/scripts/install-hooks-agy.js",
    "hooks:agy:uninstall": "npm run build && node out/scripts/install-hooks-agy.js --uninstall",
    "check:llm": "npm run build && node out/scripts/check-llm.js",
    "test:hooks": "npm run build && node --test out/tests/hooks.test.js",
    "test": "npm run build && node --test out/tests/hooks.test.js out/tests/platform.test.js out/tests/loudness.test.js out/tests/update-feed.test.js",
    "dist": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "keywords": [
    "claude-code",
    "desktop-pet",
    "electron",
    "cyberpunk",
    "edgerunners"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "electron-updater": "^6.8.11"
  },
  "build": {
    "appId": "capri.desktop",
    "productName": "Capri",
    "files": [
      "out/**",
      "!out/**/*.map",
      "src/renderer/**",
      "!src/renderer/**/*.ts",
      "src/main/windows.ps1",
      "assets/**",
      "package.json",
      "LICENSE"
    ],
    "asarUnpack": [
      "out/hooks/**",
      "src/main/windows.ps1"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Nsttt",
        "repo": "capri-desktop"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/capri.ico"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/capri-mac.png",
      "category": "public.app-category.entertainment",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "LSUIElement": true
      },
      "artifactName": "Capri-${version}-${arch}-mac.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "shortcutName": "Capri",
      "artifactName": "Capri-Setup-${version}.${ext}"
    }
  }
}
